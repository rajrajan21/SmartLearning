# Copy to /etc/studysmart.env on the server (chmod 600). Nothing here costs money.
NODE_ENV=production
PORT=3100
# Same password you set when creating the database (see setup-server.sh)
DATABASE_URL=postgres://studysmart:CHANGE_ME@127.0.0.1:5432/studysmart
# Long random text (24+ characters). It is the password for /admin. Make one with:  openssl rand -base64 36
ADMIN_KEY=CHANGE_ME
# The built website, served by this same program
WEB_DIR=/opt/studysmart/apps/web/dist
# Optional: the question helper can use a free OpenAI-compatible model. Leave empty to use lesson text only.
TUTOR_API_URL=
TUTOR_API_KEY=
TUTOR_MODEL=
