+.classroom-filters :is(input,select) { min-height: 44px; width: 100%; min-width: 0; border: 1px solid var(--line-strong, var(--muted)); border-radius: .6rem; padding: .45rem .65rem; font: inherit; background: var(--surface); color: var(--ink); }
+@media (max-width: 1230px) {
+  .shell .activity-header.top { grid-template-columns: max-content max-content minmax(0, 1fr) max-content; }
+  .activity-header .top-actions { grid-column: 1 / -1; margin-inline-start: 0; }
+}
+@media (max-width: 720px) {
+  .shell .activity-header.top { grid-template-columns: minmax(0, 1fr) max-content; }
+  .activity-header > .search.compact, .activity-header .activity-classroom { grid-column: 1 / -1; }
+  .activity-header .activity-classroom { justify-self: start; }
+  .activity-header .top-actions { justify-content: start; }
+  .classroom-filters { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .shell .appbar { padding-left: max(.4rem, env(safe-area-inset-left)); padding-right: max(.4rem, env(safe-area-inset-right)); }
+  .shell .appbar-title { font-size: clamp(1rem, 4vw, 1.2rem); overflow-wrap: anywhere; }
+  .shell .appbar-spacer { display: none; }
+  .shell .install-pop { bottom: calc(var(--tabbar-h) + .6rem + env(safe-area-inset-bottom, 0px)); }
+}
+@media (max-width: 360px) {
+  .activity-header .brand { font-size: 1rem; }
+  .classroom-filters { grid-template-columns: 1fr; }
+}
