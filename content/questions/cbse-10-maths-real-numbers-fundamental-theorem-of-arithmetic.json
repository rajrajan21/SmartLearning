      "stem": {
        "en": "Assertion (A): 6^n can never end in digit 0 for any natural number n. Reason (R): 6^n = 2^n x 3^n has no prime factor 5. Choose the correct option."
      },
      "options": [
        {
          "id": "right",
          "text": {
            "en": "Both A and R are true and R explains A"
          },
          "correct": true
        },
        {
          "id": "o0",
          "text": {
            "en": "Both are true but R does not explain A"
          },
          "correct": false,
          "whyWrong": {
            "en": "R is exactly why A holds: a number ending in 0 needs the prime 5."
          }
        },
        {
          "id": "o1",
          "text": {
            "en": "A is true but R is false"
          },
          "correct": false,
          "whyWrong": {
            "en": "R is true."
          }
        }
      ],
      "explanation": {
        "en": "A number ending in 0 is divisible by 10, so it needs both 2 and 5. 6^n has no 5."
      }
