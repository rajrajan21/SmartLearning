      "options": [
        {
          "id": "right",
          "text": {
            "en": "angrily"
          },
          "correct": true
        },
        {
          "id": "o0",
          "text": {
            "en": "angryly"
          },
          "correct": false,
          "whyWrong": {
            "en": "Drop 'y' and add '-ily'."
          }
        },
        {
          "id": "o1",
          "text": {
            "en": "angerly"
          },
          "correct": false,
          "whyWrong": {
            "en": "The base adjective is 'angry'."
          }
        }
      ],
      "explanation": {
        "en": "Adjectives ending in consonant + y change y to i before adding -ly: angrily."
      }
