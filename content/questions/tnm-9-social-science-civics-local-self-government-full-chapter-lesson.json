      "type": "mcq",
      "stem": {
        "en": "Which Constitutional Amendments gave permanent constitutional status to rural Panchayati Raj and urban local bodies in 1992?"
      },
      "options": [
        {
          "id": "right",
          "text": {
            "en": "73rd (rural) and 74th (urban) Amendments"
          },
          "correct": true
        },
        {
          "id": "o0",
          "text": {
            "en": "42nd and 44th Amendments"
          },
          "correct": false,
          "whyWrong": {
            "en": "The 42nd and 44th Amendments dealt with emergency powers and the Preamble, not local bodies."
          }
        },
        {
          "id": "o1",
          "text": {
            "en": "1st and 2nd Amendments"
          },
          "correct": false,
          "whyWrong": {
            "en": "Local bodies received constitutional status in 1992 via the 73rd and 74th Amendments."
          }
        }
      ],
      "explanation": {
        "en": "The 73rd Amendment strengthened rural Panchayats and the 74th Amendment strengthened urban Municipalities and Corporations."
      }
