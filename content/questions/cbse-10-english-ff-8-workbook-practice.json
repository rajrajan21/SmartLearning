        "en": "Convert to reported speech: Alexa said to Meena, 'Have you visited Puducherry?'"
      },
      "options": [
        {
          "id": "right",
          "text": {
            "en": "Alexa asked Meena if she had visited Puducherry."
          },
          "correct": true
        },
        {
          "id": "o0",
          "text": {
            "en": "Alexa asked Meena had she visited Puducherry."
          },
          "correct": false,
          "whyWrong": {
            "en": "Use 'if' and statement word order."
          }
        },
        {
          "id": "o1",
          "text": {
            "en": "Alexa told Meena if she visited Puducherry."
          },
          "correct": false,
          "whyWrong": {
            "en": "Use 'asked' for questions and 'had visited' for present perfect."
          }
        }
      ],
      "explanation": {
        "en": "Yes/no questions use 'asked ... if' and shift 'have visited' to 'had visited'."
      }
    },
