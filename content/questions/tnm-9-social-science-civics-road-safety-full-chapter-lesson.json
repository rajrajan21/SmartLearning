      "type": "mcq",
      "stem": {
        "en": "Which shape is used for Cautionary (Warning) road signs such as 'School Ahead' or 'Sharp Bend'?"
      },
      "options": [
        {
          "id": "right",
          "text": {
            "en": "Triangle with a red border"
          },
          "correct": true
        },
        {
          "id": "o0",
          "text": {
            "en": "Circle with a red border"
          },
          "correct": false,
          "whyWrong": {
            "en": "Circles are used for Mandatory/Regulatory signs like No Entry or Speed Limit."
          }
        },
        {
          "id": "o1",
          "text": {
            "en": "Blue rectangle"
          },
          "correct": false,
          "whyWrong": {
            "en": "Rectangles are used for Informatory signs like Hospital or Parking."
          }
        }
      ],
      "explanation": {
        "en": "Triangular signs warn road users of hazards ahead; circles give mandatory orders; rectangles give information."
      }
    },
