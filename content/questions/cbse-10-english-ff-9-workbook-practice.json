        "en": "Convert to reported speech: 'Akash: Why do I always cough?'"
      },
      "options": [
        {
          "id": "right",
          "text": {
            "en": "Akash asked why he always coughed."
          },
          "correct": true
        },
        {
          "id": "o0",
          "text": {
            "en": "Akash asked why did he always cough."
          },
          "correct": false,
          "whyWrong": {
            "en": "Use statement word order after 'why'."
          }
        },
        {
          "id": "o1",
          "text": {
            "en": "Akash told why he always coughed."
          },
          "correct": false,
          "whyWrong": {
            "en": "'told' is not used for a question without a listener."
          }
        }
      ],
      "explanation": {
        "en": "Wh-questions keep the wh-word, shift tense to past, and use statement order."
      }
