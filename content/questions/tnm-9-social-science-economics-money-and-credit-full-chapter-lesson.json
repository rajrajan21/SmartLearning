      "provenance": "original",
      "status": "published",
      "type": "mcq",
      "stem": {
        "en": "What is collateral in a bank loan?"
      },
      "options": [
        {
          "id": "o0",
          "text": {
            "en": "The monthly salary paid to a bank manager"
          },
          "correct": false,
          "whyWrong": {
            "en": "Collateral is security pledged by the borrower, not bank staff pay."
          }
        },
        {
          "id": "right",
          "text": {
            "en": "An asset such as land, gold or a vehicle pledged as security until the loan is repaid"
          },
          "correct": true
        },
        {
          "id": "o1",
          "text": {
            "en": "A fine charged when a cheque bounces"
          },
          "correct": false,
          "whyWrong": {
            "en": "Collateral is an asset pledged up front to guarantee loan repayment."
          }
        }
      ],
      "explanation": {
        "en": "Banks may ask for collateral so they can recover the loan if a borrower defaults."
      }
    },
