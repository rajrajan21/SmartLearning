          "text": {
            "en": "Urban-to-urban internal migration"
          },
          "correct": true
        },
        {
          "id": "o0",
          "text": {
            "en": "International migration"
          },
          "correct": false,
          "whyWrong": {
            "en": "Both Madurai and Chennai are inside India, so no national border was crossed."
          }
        },
        {
          "id": "o1",
          "text": {
            "en": "Rural-to-rural migration"
          },
          "correct": false,
          "whyWrong": {
            "en": "Both Madurai and Chennai are urban cities, not villages."
          }
        }
      ],
      "explanation": {
        "en": "Moving from one city to another within the same country is urban-to-urban internal migration."
      }
