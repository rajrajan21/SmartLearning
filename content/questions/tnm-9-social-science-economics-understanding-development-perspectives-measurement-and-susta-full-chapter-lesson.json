      "status": "published",
      "type": "mcq",
      "stem": {
        "en": "Why can groundwater—a renewable resource—still run dry in a farming district?"
      },
      "options": [
        {
          "id": "right",
          "text": {
            "en": "Because pumping water faster than monsoon rain recharges it lowers the water table"
          },
          "correct": true
        },
        {
          "id": "o0",
          "text": {
            "en": "Because renewable resources can never be replenished by nature"
          },
          "correct": false,
          "whyWrong": {
            "en": "Renewable resources do replenish, provided extraction stays within nature's recharge rate."
          }
        },
        {
          "id": "o1",
          "text": {
            "en": "Because sunlight destroys underground aquifers"
          },
          "correct": false,
          "whyWrong": {
            "en": "Over-extraction, not sunlight, depletes underground aquifers."
          }
        }
      ],
      "explanation": {
        "en": "Sustainable use means keeping extraction at or below the natural recharge rate."
      }
    },
