      "status": "published",
      "type": "mcq",
      "stem": {
        "en": "Which three dimensions are combined to calculate the Human Development Index (HDI)?"
      },
      "options": [
        {
          "id": "right",
          "text": {
            "en": "Health (life expectancy), education (schooling) and standard of living (income)"
          },
          "correct": true
        },
        {
          "id": "o0",
          "text": {
            "en": "Only military strength, exports and gold reserves"
          },
          "correct": false,
          "whyWrong": {
            "en": "HDI focuses on people's well-being, not military or gold reserves."
          }
        },
        {
          "id": "o1",
          "text": {
            "en": "Only population size, land area and rainfall"
          },
          "correct": false,
          "whyWrong": {
            "en": "Geography and population size do not measure human development."
          }
        }
      ],
      "explanation": {
        "en": "HDI measures human well-being through health, knowledge and a decent standard of living."
      }
    },
    {
