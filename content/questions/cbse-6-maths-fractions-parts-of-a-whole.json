     "id": "o1",
     "text": {
      "en": "7: sum of top and bottom"
     },
     "correct": false,
     "whyWrong": {
      "en": "We do not add numerator and denominator."
     }
    }
   ],
   "explanation": {
    "en": "The denominator (bottom number 4) shows the total equal parts in 1 whole."
   }
