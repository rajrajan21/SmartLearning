      "type": "mcq",
      "stem": {
        "en": "Which Fundamental Right did Dr B. R. Ambedkar describe as the 'heart and soul' of the Indian Constitution?"
      },
      "options": [
        {
          "id": "o0",
          "text": {
            "en": "Right to Property"
          },
          "correct": false,
          "whyWrong": {
            "en": "The Right to Property is no longer a Fundamental Right."
          }
        },
        {
          "id": "right",
          "text": {
            "en": "Right to Constitutional Remedies (Article 32)"
          },
          "correct": true
        },
        {
          "id": "o1",
          "text": {
            "en": "Right to Vote at age 21"
          },
          "correct": false,
          "whyWrong": {
            "en": "Voting age is 18 and is a constitutional/legal right, not Article 32."
          }
        }
      ],
      "explanation": {
        "en": "Without the Right to Constitutional Remedies (approaching courts), other Fundamental Rights could not be enforced."
      }
    },
