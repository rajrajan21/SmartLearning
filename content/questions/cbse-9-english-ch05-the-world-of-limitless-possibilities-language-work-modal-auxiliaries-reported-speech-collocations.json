      "provenance": "original",
      "status": "published",
      "type": "mcq",
      "stem": {
        "en": "Convert: Tarun said, 'I will watch this tomorrow.' -> Tarun said that he ___ watch that the following day."
      },
      "options": [
        {
          "id": "right",
          "text": {
            "en": "would"
          },
          "correct": true
        },
        {
          "id": "o0",
          "text": {
            "en": "will"
          },
          "correct": false,
          "whyWrong": {
            "en": "Past reporting verb 'said' requires will -> would."
          }
        },
        {
          "id": "o1",
          "text": {
            "en": "had"
          },
          "correct": false,
          "whyWrong": {
            "en": "Future 'will' shifts to 'would', not 'had'."
          }
        }
      ],
      "explanation": {
        "en": "Will shifts to would in indirect speech after said."
      }
    },
