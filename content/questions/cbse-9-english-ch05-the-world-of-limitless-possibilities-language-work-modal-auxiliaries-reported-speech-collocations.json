      "type": "mcq",
      "stem": {
        "en": "If the reporting verb is present ('Dr. Malik says...'), 'I believe' becomes"
      },
      "options": [
        {
          "id": "right",
          "text": {
            "en": "she believes"
          },
          "correct": true
        },
        {
          "id": "o0",
          "text": {
            "en": "she had believed"
          },
          "correct": false,
          "whyWrong": {
            "en": "Past reporting verbs trigger backshift; present 'says' keeps present tense."
          }
        },
        {
          "id": "o1",
          "text": {
            "en": "she will believe"
          },
          "correct": false,
          "whyWrong": {
            "en": "Do not shift forward to future."
          }
        }
      ],
      "explanation": {
        "en": "Present reporting verb does not backshift the quoted verb."
      }
    },
    {
