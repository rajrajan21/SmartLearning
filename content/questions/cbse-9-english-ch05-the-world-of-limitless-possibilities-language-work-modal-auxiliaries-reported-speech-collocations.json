      },
      "options": [
        {
          "id": "right",
          "text": {
            "en": "When we lived in Chennai, we would walk by the beach every evening."
          },
          "correct": true
        },
        {
          "id": "o0",
          "text": {
            "en": "Would you please open the window?"
          },
          "correct": false,
          "whyWrong": {
            "en": "Here 'would' makes a polite request."
          }
        },
        {
          "id": "o1",
          "text": {
            "en": "If he trained, he would win."
          },
          "correct": false,
          "whyWrong": {
            "en": "Here 'would' marks a conditional result."
          }
        }
      ],
      "explanation": {
        "en": "Repeated routine in past time is past habit."
      }
