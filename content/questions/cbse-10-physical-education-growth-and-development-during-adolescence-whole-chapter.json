        "en": "What is the formula for Body Mass Index (BMI)?"
      },
      "options": [
        {
          "id": "right",
          "text": {
            "en": "weight (kg) / height (m)²"
          },
          "correct": true
        },
        {
          "id": "o0",
          "text": {
            "en": "height (m) / weight (kg)"
          },
          "correct": false,
          "whyWrong": {
            "en": "Weight goes in the numerator."
          }
        },
        {
          "id": "o1",
          "text": {
            "en": "weight (kg) × height (m)"
          },
          "correct": false,
          "whyWrong": {
            "en": "Height must be squared in the denominator."
          }
        }
      ],
      "explanation": {
        "en": "BMI = weight in kg divided by square of height in metres."
      }
    },
