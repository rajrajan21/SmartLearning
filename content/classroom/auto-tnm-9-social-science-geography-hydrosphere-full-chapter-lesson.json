  "steps": [
    {
      "id": "s1",
      "narration": {
        "en": "Water is always on the move. The Sun warms the sea, rivers and ponds."
      },
      "actions": [
        {
          "do": "show",
          "target": "ttl",
          "at": 0.05
        },
        {
          "do": "show",
          "target": "sun",
