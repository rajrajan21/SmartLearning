          "do": "draw",
          "target": "sea",
          "at": 0.3
        },
        {
          "do": "write",
          "target": "sl",
          "at": 0.4
        }
      ]
    },
    {
      "id": "s2",
      "narration": {
        "en": "The warm water turns into invisible water vapour and rises into the air. This is called evaporation."
      },
      "actions": [
        {
          "do": "draw",
          "target": "a1",
          "at": 0.15
        },
        {
          "do": "show",
          "target": "ev",
          "at": 0.2
        },
        {
          "do": "write",
          "target": "t1",
          "on": "evaporation"
        }
      ]
    },
    {
      "id": "s3",
      "narration": {
        "en": "High up, the air is cold. The vapour cools and becomes tiny drops of water that make clouds. This is called condensation."
      },
      "actions": [
        {
          "do": "show",
          "target": "cl",
          "at": 0.3
        },
        {
          "do": "show",
          "target": "cl2",
          "at": 0.4
        },
        {
          "do": "write",
          "target": "t2",
          "on": "condensation"
        }
      ]
    },
    {
      "id": "s4",
      "narration": {
        "en": "When the clouds hold too much water, it falls down as rain. Then the water runs back to the rivers and the sea, and the cycle begins again."
      },
