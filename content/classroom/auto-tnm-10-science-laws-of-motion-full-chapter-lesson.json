 "steps": [
  {
   "id": "s1",
   "narration": {
    "en": "Isaac Newton described the way things move in three laws."
   },
   "actions": [
    {
     "do": "show",
     "target": "ttl",
     "at": 0.1
    }
   ]
  },
  {
   "id": "s2",
   "narration": {
    "en": "The first law: an object stays at rest, or keeps moving in a straight line at a constant speed, unless an unbalanced force acts on it. This property is called inertia."
   },
   "actions": [
    {
     "do": "draw",
     "target": "c0",
     "at": 0.08
    },
    {
     "do": "show",
     "target": "e0",
     "at": 0.12
    },
    {
     "do": "write",
     "target": "l0",
     "at": 0.18
    },
    {
     "do": "write",
     "target": "g0x0",
     "at": 0.3
    }
   ]
  },
  {
   "id": "s3",
   "narration": {
    "en": "The second law: the force on an object equals its mass times its acceleration. The same force gives a lighter object a bigger acceleration."
   },
   "actions": [
    {
     "do": "draw",
     "target": "c1",
     "at": 0.08
    },
    {
     "do": "show",
     "target": "e1",
     "at": 0.12
    },
    {
     "do": "write",
     "target": "l1",
     "at": 0.18
    },
    {
     "do": "write",
     "target": "g1x0",
     "at": 0.3
    }
   ]
  },
  {
   "id": "s4",
   "narration": {
    "en": "The third law: for every action there is an equal and opposite reaction. They act on two different objects."
   },
   "actions": [
    {
     "do": "draw",
     "target": "c2",
     "at": 0.08
    },
    {
     "do": "show",
     "target": "e2",
     "at": 0.12
    },
    {
     "do": "write",
     "target": "l2",
     "at": 0.18
    },
    {
     "do": "write",
     "target": "g2x0",
     "at": 0.3
    }
   ]
  },
  {
   "id": "s5",
   "narration": {
    "en": "These three laws explain the motion of everything from a ball to a rocket."
