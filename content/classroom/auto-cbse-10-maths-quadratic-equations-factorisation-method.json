 "steps": [
  {
   "id": "s1",
   "narration": {
    "en": "A quadratic equation has the form a x squared plus b x plus c equals zero, where a is not zero."
   },
   "actions": [
    {
     "do": "show",
     "target": "ttl",
     "at": 0.05
    },
    {
     "do": "write",
     "target": "f",
