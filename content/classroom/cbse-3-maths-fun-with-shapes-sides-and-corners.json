  "steps": [
    {
      "id": "solid",
      "narration": {
        "en": "Some shapes are not flat. They are solid, and you can hold them in your hand."
      },
      "actions": [
        {
          "do": "show",
          "target": "cube",
          "at": 0,
          "ms": 800
        },
        {
          "do": "spin",
          "target": "cube",
          "at": 0.1,
          "rate": 28
        },
        {
          "do": "write",
          "target": "t0",
          "on": "solid"
        }
      ]
    },
    {
      "id": "faces",
      "narration": {
        "en": "This is a cube. Look at its flat sides. They are called faces. A cube has six faces."
      },
      "actions": [
        {
          "do": "mark",
          "target": "cube",
          "on": "faces",
          "mode": "faces"
        },
        {
          "do": "write",
          "target": "tFaces",
          "on": "six faces",
          "ms": 700
        }
      ]
    },
    {
      "id": "edges",
      "narration": {
        "en": "Where two faces meet, we get an edge. A cube has twelve edges."
      },
      "actions": [
        {
          "do": "mark",
          "target": "cube",
          "at": 0,
          "mode": "edges"
        },
        {
          "do": "write",
          "target": "tEdges",
          "on": "twelve edges",
          "ms": 700
        }
      ]
    },
    {
      "id": "corners",
      "narration": {
        "en": "The pointed places are called corners. A cube has eight corners."
      },
      "actions": [
        {
          "do": "mark",
          "target": "cube",
          "at": 0,
          "mode": "corners"
        },
        {
          "do": "write",
          "target": "tCorners",
          "on": "eight corners",
          "ms": 700
        }
      ]
    },
    {
      "id": "recall",
      "narration": {
        "en": "Look at the cube again and think about what you saw."
      },
      "actions": [
        {
          "do": "mark",
          "target": "cube",
          "at": 0,
          "mode": "faces"
        },
        {
          "do": "pulse",
          "target": "cube",
          "at": 0.3,
          "color": "accent"
        }
      ],
      "check": {
        "stem": {
          "en": "How many faces does a cube have?"
        },
        "explanation": {
          "en": "A cube has six faces, twelve edges and eight corners."
        },
        "options": [
          {
            "id": "a",
            "text": {
              "en": "4"
            },
            "whyWrong": {
              "en": "A cube has more than four. Count the flat sides again, including the top and the bottom."
            }
          },
          {
            "id": "b",
            "text": {
              "en": "6"
            },
            "correct": true
          },
          {
            "id": "c",
            "text": {
              "en": "8"
            },
            "whyWrong": {
              "en": "Eight is the number of corners, not faces."
            }
          },
          {
            "id": "d",
            "text": {
              "en": "12"
            },
            "whyWrong": {
              "en": "Twelve is the number of edges, not faces."
            }
          }
        ]
      }
    },
