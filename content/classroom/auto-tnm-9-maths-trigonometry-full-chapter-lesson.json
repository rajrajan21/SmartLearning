  "steps": [
    {
      "id": "s1",
      "narration": {
        "en": "Take a right-angled triangle and mark one of its acute angles, theta. The side facing theta is the opposite side, the side next to it is the adjacent side, and the longest side is the hypotenuse."
      },
      "actions": [
        {
          "do": "show",
          "target": "ttl",
          "at": 0.05
        },
        {
          "do": "draw",
          "target": "tr",
          "at": 0.15
        },
        {
          "do": "draw",
          "target": "rt",
          "at": 0.3
        },
        {
          "do": "write",
          "target": "th",
          "at": 0.4
        },
        {
          "do": "write",
          "target": "op",
          "at": 0.5
        },
        {
          "do": "write",
          "target": "ad",
          "at": 0.6
        },
        {
          "do": "write",
          "target": "hy",
          "at": 0.7
        }
      ]
    },
    {
      "id": "s2",
      "narration": {
        "en": "Sine of theta is opposite over hypotenuse. Cosine is adjacent over hypotenuse. Tangent is opposite over adjacent."
      },
      "actions": [
        {
          "do": "write",
          "target": "f1",
          "at": 0.15
        },
        {
          "do": "write",
          "target": "f2",
          "at": 0.4
        },
        {
          "do": "write",
          "target": "f3",
          "at": 0.65
        }
      ]
    },
    {
      "id": "s3",
      "narration": {
        "en": "For a triangle with opposite side 3, adjacent side 4 and hypotenuse 5, sine is 3 over 5, cosine is 4 over 5 and tangent is 3 over 4."
      },
      "actions": [
        {
          "do": "write",
          "target": "ex",
          "at": 0.3
        }
      ]
    },
    {
      "id": "trig-read",
      "narration": {
        "en": "Start at A near the bottom left. The vertical leg across from A is the opposite side. The horizontal leg touching A is adjacent. The sloping side is the hypotenuse because it is opposite the right angle."
      },
