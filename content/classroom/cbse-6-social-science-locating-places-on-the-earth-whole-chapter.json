      "check": {
        "stem": {
          "en": "Look across the map from the garden to the library. In which direction is the library?"
        },
        "explanation": {
          "en": "North points up on this map. The library sits to the right of the garden, which puts it to the east."
        },
        "options": [
          {
            "id": "answer1",
            "text": {
              "en": "East"
            },
            "correct": true
          },
          {
            "id": "answer2",
            "text": {
              "en": "West"
            },
            "whyWrong": {
              "en": "West is to the left when north points upward. The library is to the right."
            }
          },
          {
            "id": "answer3",
            "text": {
              "en": "South"
            },
            "whyWrong": {
              "en": "South is down the page. The library is to the right of the garden."
            }
          }
        ]
      }
    },
