          "at": 0,
          "ms": 150
        },
        {
          "do": "draw",
          "target": "lightincident",
          "on": "incoming ray",
          "ms": 850
        },
        {
          "do": "show",
          "target": "lightleftarc",
          "on": "incoming ray",
          "ms": 300
        },
        {
          "do": "show",
          "target": "lightleftval",
          "on": "incoming ray",
          "ms": 300
        }
      ]
    },
    {
      "id": "light-reflect",
      "narration": {
        "en": "Follow the outgoing ray. Its angle is measured from the same normal, on the other side. The two angles with the normal are equal."
      },
      "actions": [
        {
          "do": "draw",
          "target": "lightreflected",
          "on": "outgoing ray",
          "ms": 850
        },
        {
          "do": "draw",
          "target": "lightrightarc",
          "on": "same normal",
          "ms": 850
        }
      ]
    },
    {
      "id": "light-picture-check",
      "narration": {
        "en": "Read the marked angle and choose the matching angle on the other side of the normal."
      },
      "actions": [],
      "check": {
        "stem": {
          "en": "What is the angle of reflection in this diagram?"
        },
        "explanation": {
          "en": "The incident ray forms forty-five degrees with the normal. The reflected ray forms the same angle with the normal."
        },
        "options": [
          {
            "id": "o1",
            "text": {
              "en": "90°"
            },
            "whyWrong": {
              "en": "That is the angle between the normal and the mirror."
            }
          },
          {
            "id": "o2",
            "text": {
              "en": "45°"
            },
            "correct": true
          },
          {
            "id": "o3",
            "text": {
              "en": "135°"
            },
            "whyWrong": {
              "en": "Use the acute angle between the outgoing ray and the normal above the mirror."
            }
          }
        ]
      }
