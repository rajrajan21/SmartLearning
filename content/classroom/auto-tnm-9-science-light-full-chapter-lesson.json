  "steps": [
    {
      "id": "s1",
      "narration": {
        "en": "When light falls on a shiny surface such as a mirror, it bounces back. This is called reflection."
      },
      "actions": [
        {
          "do": "show",
          "target": "ttl",
          "at": 0.05
        },
        {
          "do": "draw",
          "target": "mr",
          "at": 0.2
        },
        {
          "do": "write",
          "target": "tm",
          "at": 0.4
        }
      ]
    },
    {
      "id": "s2",
      "narration": {
        "en": "The ray that comes towards the mirror is the incident ray."
      },
      "actions": [
        {
          "do": "draw",
          "target": "in",
          "at": 0.2
        },
        {
          "do": "write",
          "target": "ti",
          "at": 0.5
        }
      ]
    },
    {
      "id": "s3",
      "narration": {
        "en": "The ray that bounces off is the reflected ray. The dotted line standing straight up from the mirror is the normal, and the two rays make equal angles with it."
      },
      "actions": [
        {
          "do": "draw",
          "target": "nm",
          "at": 0.1
        },
        {
          "do": "draw",
          "target": "rf",
          "at": 0.35
        },
        {
          "do": "write",
          "target": "tr",
          "at": 0.6
        }
      ]
    },
    {
      "id": "light-normal",
      "narration": {
        "en": "The normal meets the mirror at a right angle where the ray strikes. Use that line to read the angle of the incoming ray."
      },
      "actions": [
        {
          "do": "clear",
          "at": 0
        },
        {
          "do": "show",
