  "steps": [
    {
      "id": "s1",
      "narration": {
        "en": "Liquids and gases are called fluids. They press on whatever is in them."
      },
      "actions": [
        {
          "do": "show",
          "target": "ttl",
          "at": 0.1
        }
      ]
    },
    {
      "id": "s2",
      "narration": {
        "en": "Pressure is the force acting on each unit of area. The same force on a smaller area gives a bigger pressure, which is why a sharp nail goes in easily."
      },
      "actions": [
        {
          "do": "draw",
          "target": "c0",
          "at": 0.08
        },
        {
          "do": "show",
          "target": "e0",
          "at": 0.12
        },
        {
          "do": "write",
          "target": "l0",
          "at": 0.18
        },
        {
          "do": "write",
          "target": "g0x0",
          "at": 0.3
        }
      ]
    },
    {
      "id": "s3",
      "narration": {
        "en": "A fluid pushes up on an object placed in it. This upward force is called upthrust, or buoyant force."
      },
      "actions": [
        {
          "do": "draw",
          "target": "c1",
          "at": 0.08
        },
        {
          "do": "show",
          "target": "e1",
          "at": 0.12
        },
        {
          "do": "write",
          "target": "l1",
          "at": 0.18
        },
        {
          "do": "write",
          "target": "g1x0",
          "at": 0.3
        }
      ]
    },
    {
      "id": "s4",
      "narration": {
        "en": "Archimedes' principle: the upthrust on an object equals the weight of the fluid that it pushes aside."
      },
      "actions": [
        {
          "do": "draw",
          "target": "c2",
          "at": 0.08
        },
        {
          "do": "show",
          "target": "e2",
          "at": 0.12
        },
        {
          "do": "write",
          "target": "l2",
          "at": 0.18
        },
        {
          "do": "write",
          "target": "g2x0",
          "at": 0.3
        },
        {
          "do": "write",
          "target": "g2x1",
          "at": 0.3
        }
      ]
    },
    {
      "id": "s5",
      "narration": {
        "en": "Pascal's law: pressure applied to an enclosed fluid is passed on equally in all directions. A hydraulic lift works this way."
      },
      "actions": [
        {
          "do": "draw",
          "target": "c3",
          "at": 0.08
        },
        {
          "do": "show",
          "target": "e3",
          "at": 0.12
        },
        {
          "do": "write",
          "target": "l3",
          "at": 0.18
        },
        {
          "do": "write",
          "target": "g3x0",
          "at": 0.3
        },
        {
          "do": "write",
          "target": "g3x1",
          "at": 0.3
        }
      ]
    },
    {
      "id": "s6",
      "narration": {
        "en": "These ideas explain how ships float and how hydraulic machines work."
      },
      "actions": [
        {
          "do": "pulse",
          "target": "c0",
          "at": 0.2,
          "color": "good"
        }
      ]
    },
    {
      "id": "fluid-float",
      "narration": {
        "en": "A block is floating at rest with no support except the water. Its weight acts down. The water exerts an upward force called upthrust."
      },
      "actions": [
        {
          "do": "clear",
          "at": 0
        },
        {
