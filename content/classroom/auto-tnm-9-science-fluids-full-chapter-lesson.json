    {
      "id": "fluid-displace",
      "narration": {
        "en": "The shaded part shows the volume within the water surface that the block occupies. Water is displaced by that submerged volume. Its weight equals the upthrust on the block."
      },
      "actions": [
        {
          "do": "show",
          "target": "fluidvolume",
          "on": "shaded part",
          "ms": 440
        },
        {
          "do": "show",
          "target": "fluidweight",
          "on": "shaded part",
          "ms": 470
        },
        {
          "do": "show",
          "target": "fluidup",
          "on": "shaded part",
          "ms": 470
        },
        {
          "do": "pulse",
          "target": "fluidup",
          "on": "upthrust",
          "ms": 1000
        }
      ]
    },
    {
      "id": "fluid-picture-check",
      "narration": {
        "en": "Use the force label and the fact that the block floats at rest."
      },
      "actions": [],
      "check": {
        "stem": {
          "en": "What is the weight of the displaced water?"
        },
        "explanation": {
          "en": "A floating block at rest has equal upthrust and weight. The upthrust equals the weight of its displaced water, so that weight is six newtons."
        },
        "options": [
          {
            "id": "o1",
            "text": {
              "en": "0 N"
            },
            "whyWrong": {
              "en": "The net force is zero. The separate upward and downward forces are both present."
            }
          },
          {
            "id": "o2",
            "text": {
              "en": "6 N"
            },
            "correct": true
          },
          {
            "id": "o3",
            "text": {
              "en": "12 N"
            },
            "whyWrong": {
              "en": "The upward force and weight act in opposite directions. Their magnitudes are equal."
            }
          }
        ]
      }
    }
