    {
      "id": "atom-shell-check",
      "narration": {
        "en": "Use the electron dots on the outer ring to answer the question."
      },
      "actions": [
        {
          "do": "pulse",
          "target": "atomringm",
          "on": "outer ring",
          "ms": 1000
        }
      ],
      "check": {
        "stem": {
          "en": "How many valence electrons does the aluminium model show?"
        },
        "explanation": {
          "en": "Three electron dots are on the outer occupied shell. The inner rings show the other ten electrons."
        },
        "options": [
          {
            "id": "o1",
            "text": {
              "en": "2"
            },
            "whyWrong": {
              "en": "Count the outer ring. The two dots are on the first ring."
            }
          },
          {
            "id": "o2",
            "text": {
              "en": "3"
            },
            "correct": true
          },
          {
            "id": "o3",
            "text": {
              "en": "13"
            },
            "whyWrong": {
              "en": "That is the total electron count across all three rings."
            }
          }
        ]
      }
