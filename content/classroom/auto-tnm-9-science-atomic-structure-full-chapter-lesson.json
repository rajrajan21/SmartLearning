  "steps": [
    {
      "id": "s1",
      "narration": {
        "en": "An atom has a tiny centre, the nucleus, which holds protons and neutrons. Protons carry a positive charge and neutrons carry none. Here is a carbon atom with 6 protons and 6 neutrons."
      },
      "actions": [
        {
          "do": "show",
          "target": "ttl",
          "at": 0.05
        },
        {
          "do": "draw",
          "target": "nuc",
          "at": 0.3
        },
        {
          "do": "write",
          "target": "nt",
          "at": 0.5
        },
        {
          "do": "write",
          "target": "l1",
          "at": 0.7
        }
      ]
    },
    {
      "id": "s2",
      "narration": {
        "en": "Electrons, which carry a negative charge, move around the nucleus in shells. A carbon atom has 6 electrons, the same number as protons, so the atom is neutral."
      },
      "actions": [
        {
          "do": "draw",
          "target": "o1",
          "at": 0.1
        },
        {
          "do": "draw",
          "target": "o2",
          "at": 0.2
        },
        {
          "do": "draw",
          "target": "e0",
          "at": 0.4
        },
        {
          "do": "draw",
          "target": "e1",
          "at": 0.45
        },
        {
          "do": "draw",
          "target": "e2",
          "at": 0.5
        },
        {
          "do": "draw",
          "target": "e3",
          "at": 0.55
        },
        {
          "do": "write",
          "target": "l2",
          "at": 0.7
        },
        {
          "do": "write",
          "target": "l4",
          "at": 0.85
        }
      ]
    },
    {
      "id": "s3",
      "narration": {
        "en": "The first shell holds up to 2 electrons and the next shell up to 8. Carbon has 2 electrons in the first shell and 4 in the second."
      },
      "actions": [
        {
          "do": "write",
          "target": "l3",
          "at": 0.3
        }
      ]
    },
    {
      "id": "atom-nucleus",
      "narration": {
        "en": "A neutral aluminium atom has thirteen protons. An aluminium atom with mass number twenty-seven has fourteen neutrons. In this drawing, both counts belong in the nucleus."
      },
      "actions": [
        {
          "do": "clear",
          "at": 0
        },
        {
          "do": "show",
          "target": "atomtitle",
          "at": 0,
          "ms": 150
        },
        {
          "do": "show",
          "target": "atomlegend",
          "at": 0,
          "ms": 150
        },
        {
          "do": "draw",
          "target": "atomnucleus",
          "on": "in the nucleus",
          "ms": 850
        },
        {
          "do": "show",
          "target": "atomproton",
          "on": "thirteen protons",
          "ms": 410
        },
        {
          "do": "show",
          "target": "atomneutron",
          "on": "fourteen neutrons",
          "ms": 410
        }
      ]
    },
    {
      "id": "atom-shell-fill",
