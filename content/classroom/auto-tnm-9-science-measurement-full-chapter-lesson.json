  "steps": [
    {
      "id": "s1",
      "narration": {
        "en": "To compare measurements, everyone must use the same units. The SI system gives one set of units for the whole world."
      },
      "actions": [
        {
          "do": "show",
          "target": "ttl",
          "at": 0.1
        }
      ]
    },
    {
      "id": "s2",
      "narration": {
        "en": "In the SI system, length is measured in metres."
      },
      "actions": [
        {
          "do": "draw",
          "target": "c0",
          "at": 0.08
        },
        {
          "do": "show",
          "target": "e0",
          "at": 0.12
        },
        {
          "do": "write",
          "target": "l0",
