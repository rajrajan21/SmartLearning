  "steps": [
    {
      "id": "s1",
      "narration": {
        "en": "Heat always moves from a hotter place to a colder place. It can travel in three ways. In conduction, heat passes along a solid, like a metal spoon in hot tea, from the hot end to the cold end."
      },
      "actions": [
        {
          "do": "show",
          "target": "ttl",
          "at": 0.05
        },
        {
          "do": "show",
          "target": "fl",
          "at": 0.1
        },
        {
          "do": "draw",
          "target": "sp",
          "at": 0.2
        },
        {
          "do": "draw",
          "target": "ar1",
          "at": 0.4
        },
        {
          "do": "write",
          "target": "t1",
          "at": 0.6
        },
        {
          "do": "write",
          "target": "t1b",
          "at": 0.7
        }
      ]
    },
    {
      "id": "s2",
      "narration": {
        "en": "In convection, a liquid or gas carries the heat. Hot water rises, cooler water sinks, and the water goes round and round."
      },
      "actions": [
