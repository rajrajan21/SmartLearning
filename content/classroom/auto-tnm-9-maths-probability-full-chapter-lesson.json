  "steps": [
    {
      "id": "s1",
      "narration": {
        "en": "Probability measures how likely an event is. It is the number of outcomes we want divided by the number of all possible outcomes."
      },
      "actions": [
        {
          "do": "show",
          "target": "ttl",
          "at": 0.05
        },
        {
          "do": "write",
          "target": "f",
          "at": 0.5
        }
      ]
    },
    {
      "id": "s2",
      "narration": {
        "en": "A coin has two equally likely outcomes, so the probability of a head is one half. A die has six outcomes, three of them even, so the probability of an even number is three sixths, which is also one half."
      },
      "actions": [
        {
          "do": "write",
          "target": "c",
          "at": 0.25
        },
        {
          "do": "write",
          "target": "d",
          "at": 0.7
        }
      ]
    },
    {
      "id": "s3",
      "narration": {
        "en": "An event that is certain has probability 1, and an impossible event has probability 0. So a probability is never less than 0 or more than 1."
      },
      "actions": [
        {
          "do": "write",
          "target": "s",
          "at": 0.2
        },
        {
          "do": "write",
          "target": "i",
          "at": 0.5
        },
        {
          "do": "write",
          "target": "r",
          "at": 0.8
        }
      ]
    },
