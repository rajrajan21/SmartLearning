  {
   "id": "d2",
   "narration": {
    "en": "The French Revolution of 1789 introduced ideas of la patrie, the citizen, a tricolour flag and an elected National Assembly. The idea of a nation of equal citizens spread."
   },
   "actions": [
    {
     "do": "draw",
     "target": "d0",
     "at": 0.1
    },
    {
     "do": "draw",
