     "target": "t0x1",
     "at": 0.4
    }
   ]
  },
  {
   "id": "d3",
   "narration": {
    "en": "Napoleon brought the Civil Code of 1804, also called the Napoleonic Code, which ended privileges by birth and made laws equal. It also removed customs barriers."
   },
   "actions": [
    {
     "do": "draw",
     "target": "d1",
     "at": 0.1
    },
    {
     "do": "draw",
