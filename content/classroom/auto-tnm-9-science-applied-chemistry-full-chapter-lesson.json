      "actions": [],
      "check": {
        "stem": {
          "en": "With the same total material, which arrangement has more exposed area?"
        },
        "explanation": {
          "en": "The eight separate cubes expose surfaces that were inside the single cube. The total exposed area doubles."
        },
        "options": [
          {
            "id": "o1",
            "text": {
              "en": "One large cube"
            },
            "whyWrong": {
              "en": "It has fewer squares open to the surroundings."
            }
          },
          {
            "id": "o2",
            "text": {
              "en": "Eight smaller cubes"
            },
            "correct": true
          },
          {
            "id": "o3",
            "text": {
              "en": "They have equal exposed area"
            },
            "whyWrong": {
              "en": "The equal total volume does not imply equal exposed area."
            }
          }
        ]
