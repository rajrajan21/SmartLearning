  "steps": [
    {
      "id": "s1",
      "narration": {
        "en": "Numbers are grouped in sets. Start with the natural numbers: 1, 2, 3 and so on."
      },
      "actions": [
        {
          "do": "show",
          "target": "ttl",
          "at": 0.05
        },
        {
          "do": "draw",
          "target": "na",
          "at": 0.3
        },
        {
          "do": "write",
          "target": "lna",
          "at": 0.5
        },
        {
          "do": "write",
          "target": "n1",
          "at": 0.7
        }
      ]
    },
    {
      "id": "s2",
      "narration": {
        "en": "Add zero and we get the whole numbers. Add the negative numbers as well and we get the integers."
      },
      "actions": [
        {
          "do": "draw",
          "target": "wh",
          "at": 0.2
        },
        {
          "do": "write",
          "target": "lwh",
          "at": 0.35
        },
        {
          "do": "draw",
          "target": "zi",
          "at": 0.55
        },
        {
          "do": "write",
          "target": "lzi",
          "at": 0.7
        }
      ]
    },
    {
      "id": "s3",
      "narration": {
        "en": "Numbers that can be written as a fraction p over q, with q not zero, are the rational numbers. Every integer is rational."
      },
      "actions": [
        {
          "do": "draw",
          "target": "ra",
          "at": 0.25
        },
        {
          "do": "write",
          "target": "lra",
          "at": 0.5
        }
      ]
    },
    {
      "id": "s4",
      "narration": {
        "en": "Numbers that cannot be written as such a fraction, like the square root of 2 and pi, are irrational. Rational and irrational numbers together make the real numbers."
      },
      "actions": [
        {
          "do": "draw",
          "target": "ir",
          "at": 0.2
        },
        {
          "do": "write",
          "target": "lir",
          "at": 0.35
        },
        {
          "do": "write",
          "target": "i1",
          "at": 0.5
        },
        {
          "do": "write",
          "target": "i2",
          "at": 0.6
        },
        {
          "do": "write",
          "target": "i3",
          "at": 0.7
        },
        {
          "do": "draw",
          "target": "re",
          "at": 0.8
        },
        {
          "do": "write",
          "target": "lre",
          "at": 0.9
        }
      ]
    },
