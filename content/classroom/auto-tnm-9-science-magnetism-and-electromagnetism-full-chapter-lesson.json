      ],
      "check": {
        "stem": {
          "en": "What happens to the induced current after the magnet stops?"
        },
        "explanation": {
          "en": "When the magnet stops in this model, the flux no longer changes and the induced current returns to zero."
        },
        "options": [
          {
            "id": "o1",
            "text": {
              "en": "It remains unchanged."
            },
            "whyWrong": {
              "en": "That would require a continuing change of flux."
            }
          },
          {
            "id": "o2",
            "text": {
              "en": "It returns to zero."
            },
            "correct": true
          },
          {
            "id": "o3",
            "text": {
              "en": "It increases steadily."
            },
            "whyWrong": {
              "en": "A stationary magnet does not keep changing the flux in this coil."
            }
          }
        ]
      }
