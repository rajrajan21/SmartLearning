  "steps": [
    {
      "id": "s1",
      "narration": {
        "en": "A magnet has two ends, called poles. One is the north pole and the other is the south pole."
      },
      "actions": [
        {
          "do": "show",
          "target": "ttl",
          "at": 0.05
        },
        {
          "do": "draw",
          "target": "mnN",
          "at": 0.2
        },
        {
          "do": "draw",
          "target": "mnS",
          "at": 0.35
        },
        {
          "do": "write",
          "target": "nn",
          "at": 0.5
        },
        {
          "do": "write",
          "target": "ss",
          "at": 0.6
        }
      ]
    },
    {
      "id": "s2",
      "narration": {
        "en": "The north pole of one magnet pulls the south pole of another towards it. Unlike poles attract each other."
      },
      "actions": [
        {
          "do": "draw",
          "target": "at",
          "at": 0.2
        },
        {
          "do": "draw",
          "target": "at2",
          "at": 0.3
        },
        {
          "do": "write",
          "target": "att",
          "at": 0.5
        }
      ]
    },
    {
      "id": "s3",
      "narration": {
        "en": "But two north poles, or two south poles, push each other away. Like poles repel."
      },
      "actions": [
        {
          "do": "write",
          "target": "rep",
          "at": 0.3
        },
        {
          "do": "pulse",
          "target": "mn",
          "at": 0.3,
          "color": "warm"
        }
      ]
    },
