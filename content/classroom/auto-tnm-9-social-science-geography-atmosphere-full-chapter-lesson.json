  "steps": [
    {
      "id": "s1",
      "narration": {
        "en": "The atmosphere is the blanket of air around the Earth. It has five layers, one above the other."
      },
      "actions": [
        {
          "do": "show",
          "target": "ttl",
          "at": 0.05
        }
      ]
    },
    {
      "id": "s2",
      "narration": {
        "en": "We start with the lowest layer, the troposphere. This is where we live, and where clouds, rain and weather happen."
      },
      "actions": [
        {
          "do": "draw",
          "target": "r4",
          "at": 0.2
        },
        {
          "do": "write",
          "target": "a4",
          "at": 0.4
        },
        {
          "do": "write",
          "target": "b4",
          "at": 0.6
        }
      ]
    },
    {
      "id": "s3",
      "narration": {
        "en": "Above it is the stratosphere, which holds the ozone layer. Ozone protects us from the Sun's harmful ultraviolet rays."
