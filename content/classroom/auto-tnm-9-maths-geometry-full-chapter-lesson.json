      "id": "geom-cyclic-check",
      "narration": {
        "en": "Use the marked angle and the opposite vertex to choose your answer."
      },
      "actions": [],
      "check": {
        "stem": {
          "en": "The diagram gives angle A as 95°. What is angle C?"
        },
        "explanation": {
          "en": "A and C are opposite angles of the cyclic quadrilateral. Subtract ninety-five from one hundred eighty to get eighty-five degrees."
        },
        "options": [
          {
            "id": "o1",
            "text": {
              "en": "85°"
            },
            "correct": true
          },
          {
            "id": "o2",
            "text": {
              "en": "95°"
            },
            "whyWrong": {
              "en": "Opposite angles here are supplementary rather than necessarily equal."
            }
          },
          {
            "id": "o3",
            "text": {
              "en": "265°"
            },
            "whyWrong": {
              "en": "Use a straight angle of 180°, not the full 360° around the circle."
            }
          }
        ]
      }
