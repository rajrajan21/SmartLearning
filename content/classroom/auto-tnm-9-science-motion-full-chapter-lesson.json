  "steps": [
    {
      "id": "s1",
      "narration": {
        "en": "A distance-time graph shows how far something has gone as time passes. Time is along the bottom and distance is up the side."
      },
      "actions": [
        {
          "do": "show",
          "target": "ttl",
          "at": 0.05
        },
        {
          "do": "draw",
          "target": "ya",
          "at": 0.3
        },
        {
          "do": "draw",
          "target": "xa",
          "at": 0.4
        },
        {
          "do": "write",
          "target": "yl",
          "at": 0.6
        },
        {
          "do": "write",
          "target": "xl",
          "at": 0.7
        }
      ]
    },
    {
      "id": "s2",
      "narration": {
        "en": "A straight sloping line means the object covers equal distances in equal times, so it moves at a steady speed. A steeper line means a faster speed."
      },
      "actions": [
        {
          "do": "draw",
          "target": "fast",
          "at": 0.2
        },
        {
          "do": "write",
          "target": "lf",
          "at": 0.5
        },
        {
          "do": "draw",
          "target": "slow",
          "at": 0.6
        },
        {
          "do": "write",
          "target": "ls",
          "at": 0.8
        }
      ]
    },
    {
      "id": "s3",
      "narration": {
        "en": "A flat line means the distance does not change while time passes, so the object is at rest."
