          "do": "pulse",
          "target": "motionfinish",
          "on": "two endpoints",
          "ms": 1000
        }
      ],
      "check": {
        "stem": {
          "en": "What is the acceleration shown by this graph?"
        },
        "explanation": {
          "en": "The velocity rises from two to ten in four seconds. The slope is eight divided by four, or two metres per second squared."
        },
        "options": [
          {
            "id": "o1",
            "text": {
              "en": "2 m/s²"
            },
            "correct": true
          },
          {
            "id": "o2",
            "text": {
              "en": "8 m/s²"
            },
            "whyWrong": {
              "en": "Eight is the change in velocity. Divide it by the time taken."
            }
          },
          {
            "id": "o3",
            "text": {
              "en": "24 m/s²"
            },
            "whyWrong": {
              "en": "The graph’s area gives a displacement of twenty-four metres. Use its slope for acceleration."
            }
          }
        ]
      }
