  "steps": [
    {
      "id": "s1",
      "narration": {
        "en": "Sound is made when something vibrates, that is, moves quickly to and fro. A bell, a drum and our own throat all vibrate when they make a sound."
      },
      "actions": [
        {
          "do": "show",
          "target": "ttl",
          "at": 0.05
        },
        {
          "do": "show",
          "target": "sp",
          "at": 0.1
        }
      ]
    },
    {
      "id": "s2",
      "narration": {
        "en": "The vibration travels through the air as waves, until it reaches our ears. Here is a gentle wave. The waves are far apart, so the sound is low."
      },
      "actions": [
        {
          "do": "show",
          "target": "w1",
          "at": 0.3
        },
        {
          "do": "write",
          "target": "lb",
          "at": 0.7
        }
      ]
    },
    {
      "id": "s3",
      "narration": {
        "en": "A bigger vibration makes a louder sound, and faster vibrations make a higher sound. See how the waves are taller and closer now."
      },
      "actions": [
        {
          "do": "show",
          "target": "w2",
          "at": 0.2
        },
        {
          "do": "write",
          "target": "lb2",
          "at": 0.6
        }
      ]
    },
