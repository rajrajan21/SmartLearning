  "steps": [
    {
      "id": "s1",
      "narration": {
        "en": "The Earth is made of layers, like an onion. We cannot dig into them, but scientists study earthquake waves to learn about them."
      },
      "actions": [
        {
          "do": "show",
          "target": "ttl",
          "at": 0.05
        }
      ]
    },
    {
      "id": "s2",
      "narration": {
        "en": "On the outside is the crust, a thin, hard layer. We live on it."
      },
      "actions": [
        {
          "do": "draw",
          "target": "crust",
          "at": 0.2
        },
        {
          "do": "write",
          "target": "l1",
          "at": 0.5
        }
      ]
    },
    {
      "id": "s3",
      "narration": {
        "en": "Below it is the mantle, a thick layer of hot rock."
      },
      "actions": [
        {
          "do": "draw",
          "target": "mantle",
          "at": 0.2
        },
        {
          "do": "write",
          "target": "l2",
          "at": 0.5
        }
      ]
    },
    {
      "id": "s4",
      "narration": {
        "en": "At the centre is the core. The outer core is liquid metal, mostly iron and nickel, and the inner core is solid."
