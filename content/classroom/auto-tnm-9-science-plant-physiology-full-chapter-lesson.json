      "check": {
        "stem": {
          "en": "Which shoot shows a sideways growth response to light?"
        },
        "explanation": {
          "en": "B curves toward the light coming from the right. The curve is evidence of phototropism."
        },
        "options": [
          {
            "id": "o1",
            "text": {
