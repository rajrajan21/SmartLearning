  "steps": [
    {
      "id": "s1",
      "narration": {
        "en": "The Sun is a star at the centre of our Solar System. It gives us light and heat."
      },
      "actions": [
        {
          "do": "show",
          "target": "ttl",
          "at": 0.05
        },
        {
          "do": "draw",
          "target": "su",
          "at": 0.4
        }
      ]
    },
    {
      "id": "s2",
      "narration": {
        "en": "Planets travel round the Sun in paths called orbits. The planets close to the Sun take only a short time to go round, and the far ones take very long."
