  "steps": [
    {
      "id": "s1",
      "narration": {
        "en": "Atoms join together by forming bonds, so that each atom gets a full outer shell of electrons."
      },
      "actions": [
        {
          "do": "show",
          "target": "ttl",
          "at": 0.1
        }
      ]
    },
    {
      "id": "s2",
      "narration": {
        "en": "In an ionic bond, one atom gives electrons to another. Sodium gives one electron to chlorine, so they become the ions sodium plus and chloride minus, which attract each other. This makes sodium chloride, common salt."
      },
      "actions": [
        {
          "do": "draw",
          "target": "c0",
          "at": 0.08
        },
        {
          "do": "show",
          "target": "e0",
          "at": 0.12
        },
        {
          "do": "write",
          "target": "l0",
          "at": 0.18
        },
        {
          "do": "write",
          "target": "g0x0",
          "at": 0.3
        }
      ]
    },
    {
      "id": "s3",
      "narration": {
        "en": "In a covalent bond, atoms share electrons. Two hydrogen atoms share a pair of electrons to make a hydrogen molecule, H two."
      },
      "actions": [
        {
          "do": "draw",
          "target": "c1",
          "at": 0.08
        },
        {
          "do": "show",
          "target": "e1",
          "at": 0.12
        },
        {
          "do": "write",
          "target": "l1",
          "at": 0.18
        },
        {
          "do": "write",
          "target": "g1x0",
          "at": 0.3
        }
      ]
    },
    {
      "id": "s4",
      "narration": {
        "en": "Atoms form ionic bonds by giving and taking electrons, and covalent bonds by sharing them."
      },
      "actions": [
        {
          "do": "pulse",
          "target": "c0",
          "at": 0.2,
          "color": "good"
        }
      ]
    },
    {
      "id": "bond-ion-charge",
      "narration": {
        "en": "The first box carries the charge of a magnesium ion. One chloride ion has one negative charge. Compare those two charge sizes."
      },
      "actions": [
        {
          "do": "clear",
          "at": 0
        },
        {
          "do": "show",
          "target": "bondtitle",
          "at": 0,
          "ms": 150
        },
        {
          "do": "show",
          "target": "bondionmg",
          "on": "first box",
          "ms": 380
        },
        {
