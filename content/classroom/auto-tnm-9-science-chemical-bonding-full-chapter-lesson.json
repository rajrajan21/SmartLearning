          "on": "One chloride",
          "ms": 380
        }
      ]
    },
    {
      "id": "bond-ion-ratio",
      "narration": {
        "en": "One more chloride ion balances the second positive charge. That is why the formula uses two chloride ions for every magnesium ion."
      },
      "actions": [
        {
          "do": "show",
          "target": "bondioncb",
          "on": "One more chloride",
          "ms": 380
        },
        {
          "do": "show",
          "target": "bondlabcb",
          "on": "One more chloride",
          "ms": 380
        },
        {
          "do": "show",
