      {
        "id": "example",
        "type": "worked_example",
        "provenance": "original",
        "problem": {
          "en": "Compare the consistency of Sathya (total 460, SD 4.6) and Vidhya (total 480, SD 2.4) over five subjects."
        },
        "steps": [
          {
            "text": {
              "en": "Means: Sathya 460/5 = 92; Vidhya 480/5 = 96."
            },
            "why": {
              "en": "Divide totals by 5."
            }
          },
          {
            "text": {
              "en": "C.V. of Sathya = 4.6/92 x 100 = 5%."
            },
            "why": {
              "en": "SD over mean."
            }
          },
          {
            "text": {
              "en": "C.V. of Vidhya = 2.4/96 x 100 = 2.5%."
            },
            "why": {
              "en": "SD over mean."
            }
          },
          {
            "text": {
              "en": "Vidhya has the smaller C.V., so she is more consistent."
            },
            "why": {
              "en": "The smaller the C.V., the steadier the data."
            }
          }
        ]
      },
