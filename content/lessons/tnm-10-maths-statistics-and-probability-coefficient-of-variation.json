    "blocks": [
      {
        "id": "story",
        "type": "story",
        "provenance": "original",
        "title": {
          "en": "Whose marks are steadier?"
        },
        "text": {
          "en": "Sathya scored 460 and Vidhya 480 marks in five subjects, with standard deviations 4.6 and 2.4. Who is steadier? The standard deviation alone cannot tell us."
        }
      },
      {
        "id": "explain",
        "type": "explanation",
        "provenance": "original",
        "keepEnglishTerms": [
          "need for a relative measure",
          "definition",
          "Karl Pearson",
          "interpretation",
          "variability",
          "variance to SD"
        ],
        "text": {
          "en": "Standard deviation has units, so SDs of data with different units, such as kg and rupees, cannot be compared directly.\nCoefficient of variation is the standard deviation divided by the mean, multiplied by 100 percent.\nIt was suggested by Karl Pearson and has no unit.\nThe data with the smaller coefficient of variation is more consistent or stable.\nThe data with the larger coefficient of variation is more variable or less consistent.\nFor variance data, take the square root first to get the SD."
        }
      },
