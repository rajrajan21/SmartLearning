   {
    "id": "example",
    "type": "worked_example",
    "provenance": "original",
    "problem": {
     "en": "Evaluate 10 − 2 × 3 + 8 ÷ 4."
    },
    "steps": [
     {
      "text": {
       "en": "Do multiplication and division first: 2 × 3 = 6 and 8 ÷ 4 = 2."
      },
      "why": {
       "en": "So the expression is 10 − 6 + 2."
      }
     },
     {
      "text": {
       "en": "Now go left to right: 10 − 6 = 4."
      },
      "why": {
       "en": "Then 4 + 2."
      }
     },
     {
      "text": {
       "en": "4 + 2 = 6. So the answer is 6."
      },
      "why": {
       "en": "Check each step."
      }
     }
    ]
