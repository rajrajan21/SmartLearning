    "problem": {
     "en": "Find the rule: 10,100, 10,200, 10,300."
    },
    "steps": [
     {
      "text": {
       "en": "Subtract neighbours: 10,200 - 10,100 = 100."
      },
      "why": {
       "en": "Find the difference."
      }
     },
     {
      "text": {
       "en": "Same difference each time."
      },
      "why": {
       "en": "So add 100."
      }
     },
     {
      "text": {
       "en": "Next is 10,400."
      },
      "why": {
       "en": "Apply the rule."
      }
     }
