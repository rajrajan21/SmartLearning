        "problem": {
          "en": "Find the 8th term of the GP 3, 6, 12, ... and the sum of its first 5 terms."
        },
        "steps": [
          {
            "text": {
              "en": "a = 3, r = 2. t_8 = 3 x 2^7 = 3 x 128 = 384."
            },
            "why": {
              "en": "Use t_n = a r^(n-1)."
            }
          },
          {
            "text": {
              "en": "S_5 = 3 (2^5 - 1)/(2 - 1) = 3 x 31."
            },
            "why": {
              "en": "r is greater than 1, so use (r^n - 1)/(r - 1)."
            }
          },
          {
            "text": {
              "en": "S_5 = 93."
            },
            "why": {
              "en": "Check: 3 + 6 + 12 + 24 + 48 = 93."
