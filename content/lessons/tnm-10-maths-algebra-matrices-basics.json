      {
        "id": "example",
        "type": "worked_example",
        "provenance": "original",
        "problem": {
          "en": "If A = [[1, 2],[3, 4]] and B = [[0, 1],[5, 2]], find A + B and 2A."
        },
        "steps": [
          {
            "text": {
              "en": "A + B: add corresponding entries: [[1+0, 2+1],[3+5, 4+2]] = [[1, 3],[8, 6]]."
            },
            "why": {
              "en": "Both are 2 x 2, so addition is allowed."
            }
          },
          {
            "text": {
              "en": "2A: multiply every entry by 2: [[2, 4],[6, 8]]."
            },
            "why": {
              "en": "Scalar multiplication."
            }
          },
          {
            "text": {
              "en": "A + B = [[1,3],[8,6]] and 2A = [[2,4],[6,8]]."
            },
            "why": {
              "en": "Order stays 2 x 2."
            }
          }
        ]
