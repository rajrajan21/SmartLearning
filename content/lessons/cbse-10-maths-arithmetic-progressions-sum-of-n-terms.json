        "id": "example",
        "type": "worked_example",
        "provenance": "original",
        "problem": {
          "en": "How many terms of 24, 21, 18 ... must be taken so that the sum is 78?"
        },
        "steps": [
          {
            "text": {
              "en": "a = 24, d = -3. S = n/2 (48 + (n - 1)(-3)) = 78."
            },
            "why": {
              "en": "Use the S formula."
            }
          },
          {
            "text": {
              "en": "n(51 - 3n) = 156 gives 3n^2 - 51n + 156 = 0, i.e. n^2 - 17n + 52 = 0."
            },
            "why": {
              "en": "Simplify."
            }
          },
          {
            "text": {
              "en": "(n - 4)(n - 13) = 0. Both n = 4 and 13 are valid: the terms after the 8th cancel out."
            },
            "why": {
              "en": "Both give the sum 78."
            }
          }
        ]
