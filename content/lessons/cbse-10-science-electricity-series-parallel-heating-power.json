        "type": "worked_example",
        "provenance": "original",
        "problem": {
          "en": "Find the equivalent resistance of 6 ohm and 3 ohm in parallel."
        },
        "steps": [
          {
            "text": {
              "en": "1/R = 1/6 + 1/3 = 1/6 + 2/6 = 3/6."
            },
            "why": {
              "en": "Add the reciprocals."
            }
          },
          {
            "text": {
              "en": "R = 6/3 = 2 ohm."
            },
            "why": {
              "en": "Invert."
            }
          },
          {
            "text": {
              "en": "2 ohm is smaller than both resistors."
            },
            "why": {
              "en": "Check."
            }
          }
        ]
