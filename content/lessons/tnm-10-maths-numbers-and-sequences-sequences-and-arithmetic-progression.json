        "id": "example",
        "type": "worked_example",
        "provenance": "original",
        "problem": {
          "en": "Which term of the AP 3, 8, 13, 18, ... is 78?"
        },
        "steps": [
          {
            "text": {
              "en": "a = 3 and d = 5. Use t_n = a + (n - 1)d = 78."
            },
            "why": {
              "en": "Identify a and d first."
            }
          },
          {
            "text": {
              "en": "3 + (n - 1) x 5 = 78, so (n - 1) x 5 = 75 and n - 1 = 15."
            },
            "why": {
              "en": "Solve the equation for n."
            }
          },
          {
            "text": {
              "en": "n = 16. So 78 is the 16th term."
            },
            "why": {
              "en": "n must be a positive whole number."
            }
          }
        ]
