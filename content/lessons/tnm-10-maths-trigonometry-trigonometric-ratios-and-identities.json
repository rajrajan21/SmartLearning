      {
        "id": "example",
        "type": "worked_example",
        "provenance": "original",
        "problem": {
          "en": "If sin A = 3/5 and A is acute, find cos A and tan A."
        },
        "steps": [
          {
            "text": {
              "en": "Use sin squared A + cos squared A = 1: cos squared A = 1 - 9/25 = 16/25."
            },
            "why": {
              "en": "The identity links sin and cos."
            }
          },
          {
            "text": {
              "en": "cos A = 4/5 because A is acute, so cos is positive."
            },
            "why": {
              "en": "Take the positive root."
            }
          },
          {
            "text": {
              "en": "tan A = sin A / cos A = (3/5)/(4/5) = 3/4."
            },
            "why": {
              "en": "Divide."
            }
          }
        ]
