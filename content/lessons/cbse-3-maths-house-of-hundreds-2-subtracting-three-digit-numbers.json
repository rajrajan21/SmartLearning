   {
    "id": "example",
    "type": "worked_example",
    "provenance": "original",
    "problem": {
     "en": "Find 653 - 356."
    },
    "steps": [
     {
      "text": {
       "en": "Ones: 3 - 6 not possible. Break one ten to get 13 ones. 13 - 6 = 7."
      },
      "why": {
       "en": "Regroup."
      }
     },
     {
      "text": {
       "en": "Tens: now 4 tens. 4 - 5 not possible. Break one hundred: 14 tens - 5 = 9."
      },
      "why": {
       "en": "Regroup again."
      }
     },
     {
      "text": {
       "en": "Hundreds: 5 - 3 = 2. Answer 297."
      },
      "why": {
       "en": "Check: 297 + 356 = 653."
      }
     }
    ]
   },
