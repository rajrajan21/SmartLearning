      {
        "id": "example",
        "type": "worked_example",
        "provenance": "original",
        "problem": {
          "en": "Factorise x squared + 7x + 12 and evaluate 103 squared quickly."
        },
        "steps": [
          {
            "text": {
              "en": "Look for two numbers with product 12 and sum 7: 3 and 4."
            },
            "why": {
              "en": "Split the middle term."
            }
          },
          {
            "text": {
              "en": "x squared + 7x + 12 = (x + 3)(x + 4)."
            },
            "why": {
              "en": "Check: 3 x 4 = 12, 3 + 4 = 7."
            }
          },
          {
            "text": {
              "en": "103 squared = (100 + 3) squared = 10000 + 600 + 9 = 10609."
            },
            "why": {
              "en": "Use (a + b) squared."
            }
          }
        ]
