      {
        "id": "example",
        "type": "worked_example",
        "provenance": "original",
        "problem": {
          "en": "For A = [[1,2],[3,4]] and B = [[5,6],[7,8]] find A + B, 2A, AB and BA."
        },
        "steps": [
          {
            "text": {
              "en": "A + B adds corresponding entries: [[6,8],[10,12]]."
            },
            "why": {
              "en": "1+5, 2+6, 3+7, 4+8."
            }
          },
          {
            "text": {
              "en": "2A doubles every entry: [[2,4],[6,8]]."
            },
            "why": {
              "en": "Scalar multiplication."
            }
          },
          {
            "text": {
              "en": "AB: first row times columns gives 1x5+2x7 = 19 and 1x6+2x8 = 22; second row gives 3x5+4x7 = 43 and 3x6+4x8 = 50. So AB = [[19,22],[43,50]]."
            },
            "why": {
              "en": "Row by column."
            }
          },
          {
            "text": {
              "en": "BA: 5x1+6x3 = 23, 5x2+6x4 = 34, 7x1+8x3 = 31, 7x2+8x4 = 46. So BA = [[23,34],[31,46]]."
            },
            "why": {
              "en": "Different from AB."
            }
          }
        ]
      },
