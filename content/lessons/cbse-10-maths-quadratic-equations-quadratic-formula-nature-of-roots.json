      {
        "id": "example",
        "type": "worked_example",
        "provenance": "original",
        "problem": {
          "en": "Find k for which kx(x - 2) + 6 = 0 has two equal roots."
        },
        "steps": [
          {
            "text": {
              "en": "Write kx^2 - 2kx + 6 = 0, so a = k, b = -2k, c = 6."
            },
            "why": {
              "en": "Standard form."
            }
          },
          {
            "text": {
              "en": "D = 4k^2 - 24k = 4k(k - 6) = 0 gives k = 0 or 6."
            },
            "why": {
              "en": "Equal roots need D = 0."
            }
          },
          {
            "text": {
              "en": "k = 0 makes it non-quadratic, so k = 6."
            },
            "why": {
              "en": "Reject k = 0."
            }
          }
        ]
