        "provenance": "original",
        "problem": {
          "en": "Write 09:35 p.m. in 24-hour format."
        },
        "steps": [
          {
            "text": {
              "en": "It is a p.m. time, so add 12 to the hour."
            },
            "why": {
              "en": "a.m. times stay the same; p.m. times add 12."
            }
          },
          {
            "text": {
              "en": "9 + 12 = 21, so the time is 21:35."
            },
            "why": {
              "en": "The minutes do not change."
            }
          },
          {
            "text": {
              "en": "Answer: 21:35 hours."
            },
            "why": {
              "en": "Check: 21:35 minus 12 hours is 9:35 p.m."
            }
          }
        ]
