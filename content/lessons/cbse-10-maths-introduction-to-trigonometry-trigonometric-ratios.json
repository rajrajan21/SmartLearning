        "id": "example",
        "type": "worked_example",
        "provenance": "original",
        "problem": {
          "en": "If 15 cot A = 8, find sin A and sec A."
        },
        "steps": [
          {
            "text": {
              "en": "cot A = 8/15 = adjacent/opposite, so adjacent = 8 and opposite = 15."
            },
            "why": {
              "en": "Draw the triangle."
            }
          },
          {
            "text": {
              "en": "Hypotenuse = root(64 + 225) = 17, so sin A = 15/17."
            },
            "why": {
              "en": "Pythagoras."
            }
          },
          {
            "text": {
              "en": "sec A = hypotenuse/adjacent = 17/8."
            },
            "why": {
              "en": "Reciprocal of cos A."
            }
          }
        ]
