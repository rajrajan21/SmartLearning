    "keepEnglishTerms": [
     "position",
     "reference point",
     "motion"
    ],
    "text": {
     "en": "To describe a position we need a reference point and a direction and distance. 'Left of the door' needs the door as a reference.\nAn object is moving if its position changes with time compared with its surroundings. A passenger in a bus is at rest compared with the bus but moving compared with the road.\nSo rest and motion depend on the reference."
    }
   },
