    "problem": {
     "en": "A bag has 3 red and 5 blue balls. One ball is drawn at random. Find P(red) and P(not red)."
    },
    "steps": [
     {
      "text": {
       "en": "Total outcomes = 3 + 5 = 8."
      },
      "why": {
       "en": "Step 1."
      }
     },
     {
      "text": {
       "en": "P(red) = 3/8."
      },
      "why": {
       "en": "Step 2."
      }
     },
     {
      "text": {
       "en": "P(not red) = 1 − 3/8 = 5/8."
      },
      "why": {
       "en": "Step 3."
      }
     },
     {
      "text": {
       "en": "This matches the blue balls, 5 out of 8."
      },
      "why": {
       "en": "Step 4."
      }
