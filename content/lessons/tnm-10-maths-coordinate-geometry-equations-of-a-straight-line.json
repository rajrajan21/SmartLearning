      {
        "id": "example",
        "type": "worked_example",
        "provenance": "original",
        "problem": {
          "en": "Find the equation of the line through (5,-3) and (7,-4)."
        },
        "steps": [
          {
            "text": {
              "en": "Use the two point form: (y + 3)/(-4 + 3) = (x - 5)/(7 - 5)."
            },
            "why": {
              "en": "(y - y1)/(y2 - y1) = (x - x1)/(x2 - x1)."
            }
          },
          {
            "text": {
              "en": "So (y + 3)/(-1) = (x - 5)/2."
            },
            "why": {
              "en": "Cross-multiply."
            }
          },
          {
            "text": {
              "en": "2(y + 3) = -(x - 5), so 2y + 6 = -x + 5."
            },
            "why": {
              "en": "Simplify."
            }
          },
          {
            "text": {
              "en": "Hence x + 2y + 1 = 0."
            },
            "why": {
              "en": "The required equation."
            }
          }
        ]
      },
