      {
        "id": "example",
        "type": "worked_example",
        "provenance": "original",
        "problem": {
          "en": "Write 0.727272... as a fraction."
        },
        "steps": [
          {
            "text": {
              "en": "Let x = 0.7272... Multiply by 100: 100x = 72.7272..."
            },
            "why": {
              "en": "The block 72 has two digits."
            }
          },
          {
            "text": {
              "en": "Subtract: 100x - x = 72, so 99x = 72."
            },
            "why": {
              "en": "The repeating part cancels."
            }
          },
          {
            "text": {
              "en": "x = 72/99 = 8/11."
            },
            "why": {
              "en": "Divide numerator and denominator by 9."
            }
          }
        ]
