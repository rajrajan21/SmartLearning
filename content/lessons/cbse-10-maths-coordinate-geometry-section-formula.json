      {
        "id": "example",
        "type": "worked_example",
        "provenance": "original",
        "problem": {
          "en": "Find the ratio in which the point (-1, 6) divides (-3, 10) and (6, -8)."
        },
        "steps": [
          {
            "text": {
              "en": "Let the ratio be k : 1. x = (6k - 3)/(k + 1) = -1."
            },
            "why": {
              "en": "Use the x coordinate."
            }
          },
          {
            "text": {
              "en": "6k - 3 = -k - 1, so 7k = 2 and k = 2/7."
            },
            "why": {
              "en": "Solve."
            }
          },
          {
            "text": {
              "en": "Ratio is 2 : 7. Check with y: (-8(2) + 10(7))/9 = 6."
            },
            "why": {
              "en": "Verify with y."
            }
          }
        ]
      },
