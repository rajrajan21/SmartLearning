        "problem": {
          "en": "Think-Tank wants the invasion before lunch. If lunch is at 12 and the plan takes 3 hours, when should it start?"
        },
        "steps": [
          {
            "text": {
              "en": "Subtract 3 hours from 12."
            },
            "why": {
              "en": "12 - 3."
            }
