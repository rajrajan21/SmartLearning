        "id": "example",
        "type": "worked_example",
        "provenance": "original",
        "problem": {
          "en": "Find the area of the minor segment of a circle of radius 10 cm for a central angle of 90 degrees (pi = 3.14)."
        },
        "steps": [
          {
            "text": {
              "en": "Sector = 90/360 x 3.14 x 100 = 78.5 cm^2."
            },
            "why": {
              "en": "Quarter circle."
            }
          },
          {
            "text": {
              "en": "Triangle = 1/2 x 10 x 10 = 50 cm^2."
            },
            "why": {
              "en": "Right triangle of two radii."
            }
          },
          {
            "text": {
              "en": "Segment = 78.5 - 50 = 28.5 cm^2."
            },
            "why": {
              "en": "Subtract."
            }
          }
        ]
