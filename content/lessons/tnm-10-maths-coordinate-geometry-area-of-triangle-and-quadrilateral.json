      {
        "id": "example",
        "type": "worked_example",
        "provenance": "original",
        "problem": {
          "en": "Find the area of the triangle with vertices A(-3,5), B(5,-2), C(5,6)."
        },
        "steps": [
          {
            "text": {
              "en": "Take them in counter-clockwise order: A(-3,5), B(5,-2), C(5,6)."
            },
            "why": {
              "en": "x1,y1 = -3,5; x2,y2 = 5,-2; x3,y3 = 5,6."
            }
          },
          {
            "text": {
              "en": "Downward sum: (-3)(-2) + 5(6) + 5(5) = 6 + 30 + 25 = 61."
            },
            "why": {
              "en": "x1y2 + x2y3 + x3y1."
            }
          },
          {
            "text": {
              "en": "Upward sum: 5(5) + 5(-2) + (-3)(6) = 25 - 10 - 18 = -3."
            },
            "why": {
              "en": "x2y1 + x3y2 + x1y3."
            }
          },
          {
            "text": {
              "en": "Area = 1/2 |61 - (-3)| = 1/2 x 64 = 32 sq. units."
            },
            "why": {
              "en": "Check: the right side BC is 8 long and the height is 8, giving 32."
            }
          }
        ]
      },
      {
        "id": "teachback",
        "type": "teach_back",
        "provenance": "original",
        "prompt": {
          "en": "Show that P(-1.5, 3), Q(6, -2), R(-3, 4) are collinear."
        },
        "requiredIdeas": [
