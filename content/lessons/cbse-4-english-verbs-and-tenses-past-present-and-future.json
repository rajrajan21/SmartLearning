      {
        "id": "story",
        "type": "story",
        "provenance": "original",
        "title": {
          "en": "Yesterday and tomorrow"
        },
        "text": {
          "en": "Gita said, \"I play today. I played yesterday. I will play tomorrow.\"\n\"The verb changes with the time,\" said the teacher."
        }
      },
      {
        "id": "explain",
        "type": "explanation",
        "provenance": "original",
        "keepEnglishTerms": [
          "present",
          "past",
          "future"
        ],
        "text": {
          "en": "The present tense tells what happens now: She plays. The past tense tells what happened before: She played. The future tense tells what will happen: She will play.\nMost verbs add ed in the past: walk becomes walked. Some change fully: go becomes went, eat becomes ate and run becomes ran.\nFor the future we put will before the verb: will go, will eat."
        }
      },
