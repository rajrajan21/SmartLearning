        "problem": {
          "en": "A metallic sphere of radius 4.2 cm is melted and recast into a cylinder of radius 6 cm. Find the height (pi cancels)."
        },
        "steps": [
          {
            "text": {
              "en": "Sphere volume = 4/3 pi (4.2)^3."
            },
            "why": {
              "en": "Volume of sphere."
            }
          },
          {
            "text": {
              "en": "Cylinder volume = pi (36) h. Equate: 36h = 4/3 x 74.088 = 98.784."
            },
            "why": {
              "en": "Volume is conserved."
            }
          },
