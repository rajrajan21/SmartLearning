      {
        "id": "example",
        "type": "worked_example",
        "provenance": "original",
        "problem": {
          "en": "Solve 3x - 2y + z = 2, 2x + 3y - z = 5, x + y + z = 6."
        },
        "steps": [
          {
            "text": {
              "en": "Add (1) and (2): 5x + y = 7. Add (2) and (3): 3x + 4y = 11."
            },
            "why": {
              "en": "z has been eliminated twice."
            }
          },
          {
            "text": {
              "en": "Multiply 5x + y = 7 by 4: 20x + 4y = 28. Subtract 3x + 4y = 11."
            },
            "why": {
              "en": "The y terms match."
            }
          },
          {
            "text": {
              "en": "We get 17x = 17, so x = 1."
            },
            "why": {
              "en": "Then y = 7 - 5 = 2."
            }
          },
          {
            "text": {
              "en": "Put x = 1 and y = 2 in the third equation: 1 + 2 + z = 6, so z = 3."
            },
            "why": {
              "en": "Check in equation (1): 3 - 4 + 3 = 2."
            }
          },
          {
            "text": {
              "en": "Solution: x = 1, y = 2, z = 3."
            },
            "why": {
              "en": "Unique point of intersection."
            }
          }
        ]
      },
