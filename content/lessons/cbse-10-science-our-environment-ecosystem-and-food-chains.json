        "id": "example",
        "type": "worked_example",
        "provenance": "original",
        "problem": {
          "en": "If producers have 10000 J of energy, how much reaches secondary consumers?"
        },
        "steps": [
          {
            "text": {
              "en": "Primary consumers get 10% of 10000 = 1000 J."
            },
            "why": {
              "en": "First step."
            }
          },
          {
            "text": {
              "en": "Secondary consumers get 10% of 1000 = 100 J."
            },
            "why": {
              "en": "Second step."
            }
          },
          {
            "text": {
              "en": "So 100 J reaches secondary consumers."
            },
            "why": {
              "en": "Energy decreases."
            }
          }
        ]
