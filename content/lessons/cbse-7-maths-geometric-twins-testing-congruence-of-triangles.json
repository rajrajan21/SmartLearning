    "type": "explanation",
    "provenance": "original",
    "keepEnglishTerms": [
     "congruent",
     "SSS",
     "SAS",
     "ASA"
    ],
    "text": {
     "en": "Two shapes are congruent if one fits exactly on the other. Their sides and angles match.\nTwo triangles are congruent by SSS if three sides match, by SAS if two sides and the angle between them match, by ASA if two angles and the side between match, and by RHS for right triangles.\nA reflection, turn or slide of a shape keeps it congruent."
    }
   },
