        "id": "example",
        "type": "worked_example",
        "provenance": "original",
        "problem": {
          "en": "Which term of the AP 21, 18, 15, ... is -81?"
        },
        "steps": [
          {
            "text": {
              "en": "a = 21, d = -3. Use a_n = a + (n - 1)d = -81."
            },
            "why": {
              "en": "Identify a and d."
            }
          },
          {
            "text": {
              "en": "21 - 3(n - 1) = -81 so 3(n - 1) = 102 and n - 1 = 34."
            },
            "why": {
              "en": "Solve for n."
            }
          },
          {
            "text": {
              "en": "n = 35, so -81 is the 35th term."
            },
            "why": {
              "en": "n is a whole number, so it is a term."
            }
          }
        ]
