      {
        "id": "example",
        "type": "worked_example",
        "provenance": "original",
        "problem": {
          "en": "A toy is a cone on a hemisphere, both of radius 3.5 cm. Total height 15.5 cm. Find its surface area (pi = 22/7)."
        },
        "steps": [
          {
            "text": {
              "en": "Cone height = 15.5 - 3.5 = 12 cm, slant height l = root(144 + 12.25) = 12.5 cm."
            },
            "why": {
              "en": "Find the slant height."
            }
          },
          {
            "text": {
              "en": "CSA cone = 22/7 x 3.5 x 12.5 = 137.5 cm^2, hemisphere = 2 x 22/7 x 12.25 = 77 cm^2."
            },
            "why": {
              "en": "Add visible curved surfaces."
            }
          },
          {
            "text": {
              "en": "Total = 214.5 cm^2."
            },
            "why": {
              "en": "Joint circle is hidden."
            }
          }
        ]
      },
