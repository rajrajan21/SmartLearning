        "provenance": "original",
        "problem": {
          "en": "Find the distance between (2, 1) and (5, 5) and the mid-point."
        },
        "steps": [
          {
            "text": {
              "en": "Differences: 5 - 2 = 3 and 5 - 1 = 4."
            },
            "why": {
              "en": "Subtract each coordinate."
            }
          },
          {
            "text": {
              "en": "Distance = square root of (9 + 16) = 5."
            },
            "why": {
              "en": "A 3-4-5 triangle."
            }
          },
          {
            "text": {
              "en": "Mid-point = (3.5, 3)."
            },
            "why": {
              "en": "Average each coordinate."
            }
          }
        ]
