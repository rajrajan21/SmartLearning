      "en": "Nature of roots and the discriminant"
    },
    "blocks": [
      {
        "id": "story",
        "type": "story",
        "provenance": "original",
        "title": {
          "en": "Does it touch the axis?"
        },
        "text": {
          "en": "A ball is thrown and its height follows a quadratic equation. Will it reach a given height? The discriminant answers it without solving."
        }
      },
      {
        "id": "explain",
        "type": "explanation",
        "provenance": "original",
        "keepEnglishTerms": [
          "quadratic formula",
          "discriminant",
          "D positive",
          "D zero",
          "D negative",
          "finding k"
        ],
        "text": {
          "en": "The roots of ax squared plus bx plus c equal 0 are given by the quadratic formula minus b plus or minus the square root of b squared minus 4ac, all over 2a.\nThe expression b squared minus 4ac is called the discriminant D.\nIf D is greater than 0, the roots are real and unequal and the parabola cuts the X axis twice.\nIf D equals 0, the roots are real and equal and the parabola touches the X axis once.\nIf D is less than 0, there are no real roots and the parabola does not meet the X axis.\nTo find an unknown k for given nature, form D in terms of k and use D = 0, D greater than 0 or D less than 0."
        }
      },
