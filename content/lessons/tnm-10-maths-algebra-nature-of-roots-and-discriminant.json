      {
        "id": "example",
        "type": "worked_example",
        "provenance": "original",
        "problem": {
          "en": "Find k for which kx^2 - (8k + 4)x + 81 = 0 has real and equal roots."
        },
        "steps": [
          {
            "text": {
              "en": "Here a = k, b = -(8k + 4), c = 81."
            },
            "why": {
              "en": "Identify the coefficients."
            }
          },
          {
            "text": {
              "en": "D = 0 gives (8k + 4)^2 - 4 x k x 81 = 0."
            },
            "why": {
              "en": "Equal roots need D = 0."
            }
          },
          {
            "text": {
              "en": "64k^2 + 64k + 16 - 324k = 0, so 64k^2 - 260k + 16 = 0."
            },
            "why": {
              "en": "Expand and collect."
            }
          },
          {
            "text": {
              "en": "Divide by 4: 16k^2 - 65k + 4 = 0, so (16k - 1)(k - 4) = 0."
            },
            "why": {
              "en": "Factorise."
            }
          },
          {
            "text": {
              "en": "Hence k = 1/16 or k = 4."
            },
            "why": {
              "en": "Two values of k."
            }
          }
        ]
      },
      {
        "id": "teachback",
        "type": "teach_back",
        "provenance": "original",
        "prompt": {
          "en": "Find the values of k so that (k + 9)x^2 + (k + 1)x + 1 = 0 has no real roots."
        },
        "requiredIdeas": [
          {
            "en": "a = k + 9, b = k + 1, c = 1"
          },
          {
            "en": "D less than 0: (k + 1)^2 - 4(k + 9) < 0"
          },
          {
            "en": "k^2 - 2k - 35 < 0, so (k + 5)(k - 7) < 0"
          },
          {
            "en": "Hence -5 < k < 7"
          }
        ],
