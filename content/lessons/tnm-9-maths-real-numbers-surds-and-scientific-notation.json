      {
        "id": "example",
        "type": "worked_example",
        "provenance": "original",
        "problem": {
          "en": "Rationalise 1/(root 3 + 1) and write 4 500 000 in scientific notation."
        },
        "steps": [
          {
            "text": {
              "en": "Multiply top and bottom by (root 3 - 1): denominator = 3 - 1 = 2."
            },
            "why": {
              "en": "Conjugate removes the root."
            }
          },
          {
            "text": {
              "en": "So 1/(root 3 + 1) = (root 3 - 1)/2."
            },
            "why": {
              "en": "Numerator is root 3 - 1."
            }
          },
          {
            "text": {
              "en": "4 500 000 = 4.5 x 10^6."
            },
            "why": {
              "en": "Move the decimal point 6 places."
            }
          }
        ]
