        "id": "example",
        "type": "worked_example",
        "provenance": "original",
        "problem": {
          "en": "The product of two consecutive positive integers is 306. Find the integers."
        },
        "steps": [
          {
            "text": {
              "en": "Let them be x and x + 1: x(x + 1) = 306 so x^2 + x - 306 = 0."
            },
            "why": {
              "en": "Form the equation."
            }
          },
          {
            "text": {
              "en": "Factorise: (x + 18)(x - 17) = 0, so x = -18 or 17."
            },
            "why": {
              "en": "Numbers with product -306 and sum 1: 18 and -17."
            }
          },
          {
            "text": {
              "en": "Positive integers: 17 and 18. Check: 17 x 18 = 306."
            },
            "why": {
              "en": "Reject -18."
            }
          }
        ]
