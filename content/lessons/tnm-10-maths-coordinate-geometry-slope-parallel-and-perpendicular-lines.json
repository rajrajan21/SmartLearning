        "id": "example",
        "type": "worked_example",
        "provenance": "original",
        "problem": {
          "en": "Find the slope of the line through (2,3) and (6,11), and the slope of a line perpendicular to it."
        },
        "steps": [
          {
            "text": {
              "en": "Slope m = (11 - 3)/(6 - 2) = 8/4 = 2."
            },
            "why": {
              "en": "Rise 8 over run 4."
            }
          },
          {
            "text": {
              "en": "For a perpendicular line, m1 x m2 = -1."
            },
            "why": {
              "en": "So 2 x m2 = -1."
            }
          },
          {
            "text": {
              "en": "Therefore m2 = -1/2."
            },
            "why": {
              "en": "A negative reciprocal."
            }
          }
        ]
