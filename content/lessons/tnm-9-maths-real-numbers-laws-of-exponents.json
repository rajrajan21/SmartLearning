    "problem": {
     "en": "Simplify (2^3 × 2^4) ÷ 2^5."
    },
    "steps": [
     {
      "text": {
       "en": "Use the product law on the top: 2^3 × 2^4 = 2^(3+4) = 2^7."
      },
      "why": {
       "en": "Step 1."
      }
     },
     {
      "text": {
       "en": "Now use the quotient law: 2^7 ÷ 2^5 = 2^(7−5) = 2^2."
      },
      "why": {
       "en": "Step 2."
      }
     },
     {
      "text": {
       "en": "Find the value: 2^2 = 4."
      },
      "why": {
       "en": "Step 3."
      }
     }
