      {
        "id": "example",
        "type": "worked_example",
        "provenance": "original",
        "problem": {
          "en": "Find the remainder when p(x) = x cubed - 3x squared + 4x - 5 is divided by (x - 2)."
        },
        "steps": [
          {
            "text": {
              "en": "By the Remainder Theorem the remainder is p(2)."
            },
            "why": {
              "en": "Divisor x - 2 means a = 2."
            }
          },
          {
            "text": {
              "en": "p(2) = 8 - 12 + 8 - 5."
            },
            "why": {
              "en": "Substitute x = 2."
            }
          },
          {
            "text": {
              "en": "Remainder = -1."
            },
            "why": {
              "en": "8 - 12 = -4, then -4 + 8 = 4, then 4 - 5 = -1."
            }
          }
        ]
