      {
        "id": "example",
        "type": "worked_example",
        "provenance": "original",
        "problem": {
          "en": "Find the distance between (1, 2) and (7, 10) and their mid-point."
        },
        "steps": [
          {
            "text": {
              "en": "Differences: 7 - 1 = 6 and 10 - 2 = 8."
            },
            "why": {
              "en": "Subtract coordinates."
            }
          },
          {
            "text": {
              "en": "Distance = square root of (36 + 64) = 10."
            },
            "why": {
              "en": "This is a 6-8-10 right triangle."
            }
          },
          {
            "text": {
              "en": "Mid-point = ((1+7)/2, (2+10)/2) = (4, 6)."
            },
            "why": {
              "en": "Average each coordinate."
            }
          }
        ]
