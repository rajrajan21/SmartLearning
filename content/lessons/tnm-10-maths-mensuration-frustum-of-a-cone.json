      {
        "id": "example",
        "type": "worked_example",
        "provenance": "original",
        "problem": {
          "en": "A bucket in the shape of a frustum has top diameter 10 m, bottom diameter 4 m and height 4 m. Find its curved and total surface areas."
        },
        "steps": [
          {
            "text": {
              "en": "R = 5 m, r = 2 m, h = 4 m. Slant height l = sqrt(4^2 + (5-2)^2) = sqrt(25) = 5 m."
            },
            "why": {
              "en": "The 3-4-5 triangle."
            }
          },
          {
            "text": {
              "en": "CSA = pi (R + r) l = 22/7 x 7 x 5 = 110 sq. m."
            },
            "why": {
              "en": "(5 + 2) = 7."
            }
          },
          {
            "text": {
              "en": "TSA = 110 + pi (25 + 4) = 110 + 22/7 x 29 = 110 + 91.14."
            },
            "why": {
              "en": "Add both circular ends."
            }
          },
          {
            "text": {
              "en": "TSA is about 201.14 sq. m."
            },
            "why": {
              "en": "Rounded to two decimals."
            }
          }
        ]
      },
