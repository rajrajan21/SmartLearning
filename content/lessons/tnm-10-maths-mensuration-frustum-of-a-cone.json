    "blocks": [
      {
        "id": "story",
        "type": "story",
        "provenance": "original",
        "title": {
          "en": "The fire bucket"
        },
        "text": {
          "en": "Glasses, buckets and street cones are not exact cones: their tops are cut off. A cone with its top sliced off by a plane parallel to the base is called a frustum."
        }
      },
      {
        "id": "explain",
        "type": "explanation",
        "provenance": "original",
        "keepEnglishTerms": [
          "frustum",
          "notation",
          "slant height",
          "curved surface area",
          "total surface area",
          "volume"
        ],
        "text": {
          "en": "A frustum is the part of a cone between its base and a plane parallel to the base.\nLet R be the radius of the larger base, r the radius of the top, h the height and l the slant height of the frustum.\nThe slant height is the square root of h squared plus (R minus r) squared.\nThe curved surface area is pi times (R plus r) times l.\nThe total surface area adds the two circular ends: pi (R plus r) l plus pi R squared plus pi r squared.\nThe volume is the difference of two cones; using similar triangles it becomes pi h over 3 times (R squared plus R r plus r squared)."
        }
      },
