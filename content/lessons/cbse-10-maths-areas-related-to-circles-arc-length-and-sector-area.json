    "blocks": [
      {
        "id": "story",
        "type": "story",
        "provenance": "original",
        "title": {
          "en": "A slice of pizza"
        },
        "text": {
          "en": "A pizza slice is a sector of a circle. How much cheese covers it, and how long is its crust edge? A simple fraction of the whole circle answers both."
        }
      },
      {
        "id": "explain",
        "type": "explanation",
        "provenance": "original",
        "keepEnglishTerms": [
          "2 pi r and pi r^2",
          "360 - theta",
          "6 pi cm^2",
          "arc = theta/360 x 2 pi r",
          "area = theta/360 x pi r^2",
          "minor and major sector",
          "pi = 22/7",
          "sector, angle theta"
        ],
        "text": {
          "en": "The circumference of a circle is 2 pi r and its area is pi r squared, where r is the radius.\nA sector is the region between two radii and the arc between them. Its angle at the centre is theta degrees.\nA sector is theta by 360 of the whole circle. So its area is theta/360 times pi r squared.\nThe length of its arc is theta/360 times 2 pi r.\nExample: radius 6 cm and angle 60 degrees. Area = 60/360 x pi x 36 = 6 pi cm squared.\nThe smaller sector is the minor sector and the larger one is the major sector. The two angles add up to 360 degrees.\nFor a major sector, use 360 minus theta as its angle, or subtract the minor sector from the whole circle.\nUse pi = 22/7 unless the question says otherwise, and give the unit as square centimetres for area."
        }
      },
