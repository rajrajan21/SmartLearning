    "title": {
     "en": "A short story"
    },
    "text": {
     "en": "A diver went down 3 metres every minute for 4 minutes.\n\"That is minus 12 metres,\" said Ravi."
    }
   },
   {
    "id": "explain",
    "type": "explanation",
    "provenance": "original",
    "keepEnglishTerms": [
     "positive",
     "negative",
     "product"
    ],
    "text": {
     "en": "Multiplying two numbers with different signs gives a negative answer: 3 times minus 4 is minus 12. Multiplying two negatives gives a positive: minus 3 times minus 4 is 12.\nDivision follows the same sign rule: minus 12 divided by 4 is minus 3 and minus 12 divided by minus 4 is 3.\nZero times any integer is zero."
    }
   },
