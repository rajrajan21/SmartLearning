        "provenance": "original",
        "problem": {
          "en": "A bag has 3 red and 5 blue balls. One ball is drawn at random. Find P(red) and P(not red)."
        },
        "steps": [
          {
            "text": {
              "en": "Total balls = 8; red balls = 3."
            },
            "why": {
              "en": "Count outcomes."
            }
          },
          {
            "text": {
              "en": "P(red) = 3/8."
            },
            "why": {
              "en": "Favourable over total."
            }
          },
          {
            "text": {
              "en": "P(not red) = 1 - 3/8 = 5/8."
            },
            "why": {
              "en": "Complement rule."
            }
          }
        ]
