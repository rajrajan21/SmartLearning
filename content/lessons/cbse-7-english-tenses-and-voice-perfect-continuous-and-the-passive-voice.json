      {
        "id": "story",
        "type": "story",
        "provenance": "original",
        "title": {
          "en": "The broken window"
        },
        "text": {
          "en": "The boy broke the window. The window was broken by the boy.\n\"Both sentences say the same thing in different ways,\" said the teacher."
        }
      },
      {
        "id": "explain",
        "type": "explanation",
        "provenance": "original",
        "keepEnglishTerms": [
          "perfect continuous",
          "active voice",
          "passive voice"
        ],
        "text": {
          "en": "Present perfect continuous shows an action that began earlier and is still going on: She has been reading for an hour. It uses has been or have been with the ing form.\nIn active voice the doer comes first: The boy broke the window. In passive voice the receiver comes first: The window was broken by the boy.\nTo make the passive, use a form of be with the past participle, and put by before the doer."
        }
      },
