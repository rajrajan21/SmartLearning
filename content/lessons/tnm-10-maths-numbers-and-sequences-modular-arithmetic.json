      {
        "id": "example",
        "type": "worked_example",
        "provenance": "original",
        "problem": {
          "en": "Find the remainder when 2^5 x 7 is divided by 5, i.e. compute 2^5 x 7 (mod 5)."
        },
        "steps": [
          {
            "text": {
              "en": "2^5 = 32 and 32 = 2 (mod 5), because 32 - 2 = 30."
            },
            "why": {
              "en": "Reduce each factor first."
            }
          },
          {
            "text": {
              "en": "7 = 2 (mod 5)."
            },
            "why": {
              "en": "7 - 2 = 5, divisible by 5."
            }
          },
          {
            "text": {
              "en": "So the product = 2 x 2 = 4 (mod 5). The remainder is 4."
            },
            "why": {
              "en": "Multiply the reduced numbers."
            }
          }
        ]
