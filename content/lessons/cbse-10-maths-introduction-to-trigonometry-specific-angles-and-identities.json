      {
        "id": "example",
        "type": "worked_example",
        "provenance": "original",
        "problem": {
          "en": "Prove that (1 + tan squared A)(1 - sin A)(1 + sin A) = 1."
        },
        "steps": [
          {
            "text": {
              "en": "1 + tan^2 A = sec^2 A and (1 - sin A)(1 + sin A) = 1 - sin^2 A = cos^2 A."
            },
            "why": {
              "en": "Use identities."
            }
          },
          {
            "text": {
              "en": "sec^2 A x cos^2 A = (1/cos^2 A) x cos^2 A."
            },
            "why": {
              "en": "Substitute."
            }
          },
          {
            "text": {
              "en": "= 1. Hence proved."
            },
            "why": {
              "en": "LHS equals RHS."
            }
          }
        ]
      },
