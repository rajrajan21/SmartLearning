    "keepEnglishTerms": [
     "half past",
     "quarter past",
     "quarter to",
     "minutes"
    ],
    "text": {
     "en": "When the minute hand is on 6, 30 minutes have passed. This is half past.\nWhen the minute hand is on 3, 15 minutes have passed. This is quarter past.\nWhen the minute hand is on 9, 15 minutes are left for the next hour. This is quarter to.\nHalf past 4 is 4:30, quarter past 4 is 4:15, and quarter to 5 is 4:45.\nWrite the number of minutes passed by watching the movement of the minute and hour hands.\nWrite what you can do in 5, 10, 15, 20, 25, 30, 45 and 60 minutes."
    }
