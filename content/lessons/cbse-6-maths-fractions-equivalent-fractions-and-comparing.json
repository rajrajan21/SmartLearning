   {
    "id": "explain",
    "type": "explanation",
    "provenance": "original",
    "keepEnglishTerms": [
     "equivalent",
     "denominator",
     "mixed number"
    ],
    "text": {
     "en": "Equivalent fractions show the same amount. 1/2 equals 2/4 equals 3/6. We multiply or divide top and bottom by the same number.\nTo compare fractions with the same denominator, the larger numerator is bigger. With different denominators, first make them equal. 1/2 is 3/6 and 2/3 is 4/6 so 2/3 is bigger.\nA mixed number has a whole part and a fraction, like 1 and 1/2."
    }
