# Copy to .env. Nothing here costs money.
PORT=3000
DATABASE_URL=postgres://studysmart:studysmart@localhost:5432/studysmart
# Optional free LLM keys (Module 8). Leave empty: site must work without AI.
GEMINI_API_KEY=
GROQ_API_KEY=
# Admin page key. REQUIRED in production, at least 24 random characters. Never commit the real one.
ADMIN_KEY=
# Admin sign-in user id (shown pre-filled on /admin). Sign in with this id plus ADMIN_KEY. Compared ignoring upper/lower case.
ADMIN_USER_ID=itsme.rajrajan@gmail.com
# Optional: signs the invite-code cookie (16+ characters). Empty = derived from ADMIN_KEY.
ACCESS_COOKIE_SECRET=

# Folder with the downloaded textbooks (manifest.json + pdf/class-N/*.pdf). Default: content/books
# BOOKS_DIR=
